# ===== Banco (obrigatório para contas e compras) =====
# Supabase → Project Settings → Database → Connection string (Transaction pooler, porta 6543)
DATABASE_URL=postgresql://postgres.xxxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# ===== Login (Supabase Auth, botão Entrar com Google) =====
# O ID e a chave secreta do cliente Google ficam no painel do Supabase (Authentication → Providers → Google), não aqui.
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...

# ===== Pagamento (Mercado Pago Checkout Pro) =====
MP_ACCESS_TOKEN=APP_USR-...
MP_WEBHOOK_SECRET=assinatura-secreta-do-painel-de-webhooks

# URL pública: retorno do login (SITE_URL/api/auth/callback) e back_urls/notification_url do Mercado Pago
SITE_URL=https://dora-livre.vercel.app

# ===== Somente desenvolvimento/teste =====
# Liga login com Google e Mercado Pago simulados (tela de Google de teste e checkout de teste). NUNCA use em produção.
# DORALIVRE_MODO_TESTE=1
